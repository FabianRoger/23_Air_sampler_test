    ratio > 1 & ratio < 10 ~ "> 01",
    ratio > 10 ~ "> 10")) %>%
  group_by(ratio_cat, Sampler) %>%
  summarise(n = n()) %>%
  pivot_wider(names_from = ratio_cat, values_from = n, values_fill = 0)
```

# exclude contaminants

- For every OTU present in any laboratory negative control we remove twice the number of the maximum reads from all samples.
- For every OTU present in a field negative control at higher average abundance than in the samples we remove twice the max number of reads from all samples.
- OTUs present in the field negative control at lower average abundance than in the sample are kept untouched.

```{r}
Remove_reads_lab <-
  Lab_only %>%
  filter(name == "max_val") %>%
  select(seq, value)

Remove_reads_field <-
Field_only %>%
  group_by(seq) %>%
  filter(min(ratio) > 1) %>%
  ungroup() %>%
  filter(name == "max_val") %>%
  select(seq, value)

Remove_reads <-
  bind_rows(Remove_reads_lab,
            Remove_reads_field) %>%
  group_by(seq) %>%
  filter(value == max(value)) %>%
  mutate(seq_remove = value * 2) %>%
  mutate(seq_remove = ceiling(seq_remove))

Bac_mat <- as.matrix(Bac_ASV[,-1])
Remove_mat <- Bac_mat
Remove_mat[] <- 0
Remove_mat[,Remove_reads$seq] <- rep(Remove_reads$seq_remove, each = nrow(Remove_mat))

Bac_mat_clean <- Bac_mat - Remove_mat
Bac_mat_clean[Bac_mat_clean < 0] <- 0
```

- remove empty OTUs

```{r}
Bac_mat_clean <- Bac_mat_clean[, colSums(Bac_mat_clean) > 0]
```

```{r}
ncol(Bac_mat) - ncol(Bac_mat_clean)
```

- back-transform to tibble and add back sample index

```{r}
Bac_ASV <-
as_tibble(Bac_mat_clean) %>%
  bind_cols(select(Bac_ASV, "Index"), .)
```

- remove controls from ASV data

```{r}
blank_index <-
  Meta %>%
  filter(!Type %in% c("active", "passive")) %>%
  pull(Index)

Bac_ASV <-
Bac_ASV %>%
  filter(!Index %in% blank_index)
```

