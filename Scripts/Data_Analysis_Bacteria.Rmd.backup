---
title: "Bacteria data analysis"
output: html_notebook
---

```{r}
library(dplyr)
library(tidyr)
library(purrr)
library(forcats)
library(here)
library(readr)
library(ggplot2)
library(vegan)
library(readxl)
library(corrplot)
library(Biostrings)
library(decontam)
library(eulerr)
```

# Set-up

## define Marker

```{r}
primer <- "Bacteria"
```

## load meta-data

```{r}
Meta <- read_tsv(here("Data", "Meta_data.tsv"))
```

# load data

```{r}
Bac_ASV <- read_tsv(here("Data", primer, "out_final", "Bacteria_ASW_glom.txt")) %>%
  mutate(Sample = gsub(".+?(NGS.+)", "\\1", Sample)) %>%
  dplyr::rename(Index = Sample)

Bac_tax <- read_tsv(here("Data", primer, "out_final", "Bacteria_taxa_80_glom.txt"))

Bac_seq <- readDNAStringSet(here("Data", primer, "out_final", paste(primer, "Seq_glom", sep = "_")))

DNAC <- read_tsv(here("Data", "DNA_conc_air_sampler_comp.txt"))
```

# fragment length distribution

```{r}
Bac_len <-
Bac_seq %>%
  width() %>%
  tibble(len = .) %>%
  mutate(seq = names(Bac_seq))

Bac_len %>%
  group_by(len) %>%
  summarise(n = n()) %>%
  ggplot(aes(x = len, y = n))+
  geom_bar(stat = "identity")

Bac_ASV %>%
  pivot_longer(-Index, names_to = "seq") %>%
  group_by(seq) %>%
  summarise(prev = sum(value > 0),
            reads = sum(value)) %>%
  na.omit() %>%
  filter(reads < quantile(reads, 0.9)) %>%
  left_join(Bac_len) %>%
  mutate(reads_o_prev = reads/prev) %>%
  ggplot(aes(x = len, y = reads_o_prev))+
  geom_point(shape = 21, alpha = 0.5, size = 3)
```

# rarefaction

```{r}
Bac_tax %>%
  group_by(phylum) %>%
  summarise(n = n()) %>%
  arrange(desc(n))
```

```{r}
# Build rarefaction curves per major phylum
major_phyla <- Bac_tax %>%
  group_by(phylum) %>%
  summarise(n = n()) %>%
  filter(!is.na(phylum)) %>%
  arrange(desc(n)) %>%
  dplyr::slice(1:4) %>%
  pull(phylum)

major_phyla <- c(major_phyla, "Other")

rc_df <- map_df(major_phyla, function(ph) {

  if(ph == "Other"){
    seqs <- Bac_tax %>%
    filter(!phylum %in% major_phyla) %>%
    pull(seq)
  } else{
    seqs <- Bac_tax %>%
    filter(phylum == ph) %>%
    pull(seq)
  }

  asv_sub <- Bac_ASV %>%
    select(Index, any_of(seqs)) %>%
    data.frame()

  rownames(asv_sub) <- asv_sub$Index
  asv_mat <- asv_sub[, -1, drop = FALSE] %>% as.matrix()

  if(ncol(asv_mat) == 0) return(tibble())

  rarecurve(
    asv_mat,
    step = 1000,
    label = FALSE,
    tidy = TRUE
  ) %>%
    dplyr::rename(Index = Site) %>%
    mutate(phylum = ph)
})

rc_plot_df <- rc_df %>%
  left_join(Meta, by = "Index")

ggplot(rc_plot_df, aes(x = Sample, y = Species, color = duration, group = Index)) +
  geom_line() +
  facet_wrap(~phylum, scales = "free_y", ncol = 2) +
  theme_minimal()+
  theme(legend.position = "right")+
  scale_color_brewer(palette = "Set1")
```

Sequencing depth varied between samples but reached saturation in most cases.

# clean data

## index hopping

We demultiplexed with all indices (full Plate) but not all were used. Unused indices should not have been found but could be present in the data due to random mutations and maximum likelihood index-assignment.

```{r}
index_hop <-
Bac_ASV %>%
  filter(!Index %in% Meta$Index) %>%
  pivot_longer(-Index) %>%
  filter(value > 0)

index_hop
```

```{r}
Bac_ASV <-
  Bac_ASV %>%
  filter(Index %in% Meta$Index)
```

## check controls

### decontam

```{r}
# define which samples are blanks
# field controls set to NA (excluded) as they contain genuine sequences

Blanks <-
Meta %>%
  filter(Index %in% Bac_ASV$Index) %>%
  select(Index, Sample_names, Type) %>%
  mutate(is_neg = case_when(Type %in% c("active", "passive") ~ FALSE,
                            Type %in% c("extr_control", "PCR_control") ~ TRUE,
                            Type == "field_control" ~ NA)) %>%
  arrange(Index)

# check that sample order is matching
all(Bac_ASV$Index == Blanks$Index)

# run decontam
contamdf.prev <- isContaminant(as.matrix(Bac_ASV[,-1]),
                               neg = Blanks$is_neg,
                               method="prevalence")

p_thresholds = seq(1,0,-0.001)

contam_counts <- purrr::map_df(p_thresholds, function(x) {
  tibble(
    p_threshold = x,
    num_contaminants = sum(contamdf.prev$p < x, na.rm = TRUE)
  )
})

ggplot(contam_counts, aes(x = p_threshold, y = num_contaminants)) +
  geom_point(size = 0.1)+
  geom_smooth(linewidth = 0.5, color = "red") +
  geom_vline(xintercept = 0.1, colour = "blue")+
  labs(
    title = "Prevalence-based contaminant detection",
    x = "P-value Threshold",
    y = "Number of Contaminants"
  ) +
  theme_minimal()+
  scale_x_reverse()
```

```{r}
contam_seqs <-
contamdf.prev %>%
  filter(p < 0.1) %>%
  tibble::rownames_to_column("seq")
```

### visualize contaminant sequences

- abundance ratio between blanks and samples

```{r}
cont_ratio <-
Bac_ASV %>%
  pivot_longer(-Index, names_to = "seq") %>%
  left_join(Meta) %>%
  select(Index, seq, Sample_names, Type, value) %>%
  mutate(Type = case_when(Type %in% c("active", "passive") ~ "Sample",
                            Type %in% c("extr_control", "PCR_control") ~ "Lab",
                            Type == "field_control" ~ "Field")) %>%
  group_by(Type, seq) %>%
  summarise(mean_val = round(mean(value),2),
            max_val = max(value)) %>%
  pivot_longer(one_of(c("mean_val", "max_val"))) %>%
  pivot_wider(names_from = Type, values_from = value) %>%
  filter(Lab > 0 | Field > 0) %>%
  pivot_longer(!one_of("seq", "Sample", "name"), names_to= "Type") %>%
  mutate(ratio = round(value/Sample,3))

Field_only <-
cont_ratio %>%
  filter(Type == "Field") %>%
  filter(value > 0)

Lab_only <-
cont_ratio %>%
  filter(Type == "Lab") %>%
  filter(value > 0)
```

### lab controls

```{r}
Lab_only$seq %>% unique %>% length()
```

```{r}
Lab_only %>%
  filter(name == "mean_val") %>%
  filter(ratio > 1) %>%
  nrow()
```

```{r}
Bac_ASV %>%
  pivot_longer(-Index, names_to = "seq") %>%
  filter(seq %in% unique(Lab_only$seq)) %>%
  left_join(Meta) %>%
  filter(Type %in% c("extr_control", "PCR_control")) %>%
  group_by(seq) %>%
  filter(sum(value) > 0) %>%
  left_join(
        {filter(cont_ratio,
                Type == "Lab",
                name == "mean_val") %>%
            select(seq, ratio)
            }
  ) %>%
  mutate(ratio = ifelse(value == 0, NA, ratio)) %>%
  left_join(Bac_tax) %>%
  mutate(spec_name =
           case_when(!is.na(species) ~ paste(species, seq, sep = " "),
                     !is.na(genus) ~ paste(genus, "sp.", seq, sep = " "),
                     !is.na(family) ~ paste(family, "(fam)", seq, sep = " "),
                     !is.na(order) ~ paste(order, "(ord)", seq, sep = " "),
                     !is.na(class) ~ paste(class, "(cl)", seq, sep = " "),
                     !is.na(phylum) ~ paste(phylum, "(ph)", seq, sep = " "),
                     TRUE ~ seq)) %>%
  ggplot(aes(x = Sample_names, y = spec_name, fill = ratio))+
  geom_tile()+
  scale_fill_viridis_c(na.value = "white")+
  theme(axis.text.x = element_text(angle = 90, hjust = 0))
```

