```{r}
S_df <-
Bac_ASV_clean_long %>%
  group_by(Index) %>%
  filter(reads > 0) %>%
  summarise(S = n()) %>%
  left_join(Meta) %>%
  filter(Sampler != "Drone") %>%
  mutate(Sampler = factor(Sampler, levels = unique(.$Sampler)[c(8,1,3,2,5,6,4,7)]))

S_df %>%
  mutate(Sampler = factor(Sampler, levels = c("Kärcher","Coriolis", "Sass", "Hepa",
                                             "Burkhart", "Electrostatic", "MWAC",
                                             "WSL_Filter"))) %>%
  ggplot(aes(y = S, x = duration, colour = Sites))+
