## subset for Bacteria only

- keep only sequences assigned to the kingdom "Bacteria" at phylum level

```{r}
Bac_tax <-
  Bac_tax %>%
  filter(seq %in% colnames(Bac_ASV))
```

```{r}
Bac_ASV_long %>%
  group_by(seq) %>%
  summarise(reads = sum(reads)) %>%
  left_join(Bac_tax) %>%
  group_by(kingdom, phylum) %>%
  summarise(n_OTUs = n(),
            reads = sum(reads)) %>%
  pivot_longer(one_of(c("n_OTUs", "reads"))) %>%
  ggplot(aes(x = phylum, y = value)) +
  facet_grid(kingdom~name, scales = "free", space = "free")+
  geom_bar(stat = "identity")+
  coord_flip()+
  scale_y_log10()+
  theme(axis.text.x = element_text(angle = 90))
```

- keep sequences assigned at phylum level

```{r}
Bac_seq_keep <-
Bac_tax %>%
  filter(!is.na(phylum)) %>%
  pull(seq)
```

```{r}
ncol(Bac_ASV[,-1]) - length(Bac_seq_keep)
```

```{r}
Bac_ASV_long %>%
  group_by(seq) %>%
  summarise(reads = sum(reads)) %>%
  left_join(Bac_tax) %>%
  mutate(cat = case_when(!is.na(phylum) ~ "assigned",
                         TRUE ~ "unassigned")) %>%
  group_by(cat) %>%
  summarise(reads = sum(reads),
            n_seq = n()) %>%
  mutate(reads_prct = signif(reads/sum(reads)*100,2),
         seq_prct = signif(n_seq/sum(n_seq)*100,2))
```

```{r}
Bac_ASV_clean <-
  Bac_ASV %>%
  select(one_of("Index", Bac_seq_keep))
```

```{r}
Bac_ASV_clean_long <-
  pivot_longer(Bac_ASV_clean, -Index, names_to = "seq", values_to = "reads")
```

