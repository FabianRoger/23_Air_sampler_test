```{r}
Sample_reads <-
Bac_ASV %>%
  pivot_longer(-Index) %>%
  group_by(Index) %>%
  summarise(value = sum(value)) %>%
  arrange(value) %>%
  left_join(Meta)

Sample_reads
```

