# =============================================
# .gitignore for 23_Air_sampler_test
# =============================================
# Track scripts, small data/text files, and
# documentation. Exclude large binary files,
# raw sequencing data, and generated outputs.
# =============================================

# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_cache/

# --- OS ---
.DS_Store
Thumbs.db

# --- Generated HTML outputs ---
*.html
*.nb.html

# --- Large sequence / binary files (global) ---
*.fasta
*.fa
*.fq
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.sam
*.udb
*.rds

# --- Demultiplexed and filtered sequencing reads ---
Data/*/demultiplexed/
Data/*/filtered/

# --- Sequencing data directory ---
Sequencing_data/

# --- Figures (generated from scripts) ---
Figures/

# --- Intermediate processing files ---
# Generated by Seq_Analysis scripts; only out_final/ is needed
Data/*/out_intermediate/

# --- Demultiplexing statistics ---
# Intermediate bbduk statistics from demultiplexing
Data/bbduk_stats/

# --- Large reference database taxonomy/GBIF files ---
# Generated by Prepare_RefDB.Rmd from public databases.
# Exclude files > 5 MB in in_files/ by name pattern.
Data/Fungi/in_files/Unite_*
Data/Fungi/in_files/sh_*
Data/Insects/in_files/MIDORI*
Data/Insects/in_files/Bold_gbif*
Data/Insects/in_files/Midori_gbif_sp*
Data/Plants/in_files/Plant_ITS_db/Midori*
Data/Plants/in_files/Plant_ITS_db/its2*
Data/Plants/in_files/Plant_ITS_db/its_global*
Data/Plants/in_files/Plant_ITS_db/EU_dbs/
Data/Plants/in_files/Unite_*
Data/Plants/ITSX_out/
Data/Vertebrates/in_files/MIDORI*
Data/Vertebrates/in_files/Midori_lr_gbif_sp*
Data/Vertebrates/in_files/Midori_lr_gbif.fa
Data/Bacteria/in_files/trainset19_072023.rdp/*.fasta
